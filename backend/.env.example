PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/madfood?retryWrites=true&w=majority
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5000
ADMIN_EMAIL=admin@madfood.com
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=9999999999
OTP_EXPIRES_MINUTES=5
# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional payment provider placeholders
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
